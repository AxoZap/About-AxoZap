{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axozap-internships-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "https://axozapteam.cloudflareaccess.com",
    "CF_ACCESS_AUD": "d3ccb92bdc7e98e7632c2f93f675554a3741935acad2fb1667ae48fe8b6f"
  },
  "d1_databases": [
    {
      "binding": "axozap_internships_db",
      "database_name": "axozap-internships-db",
      "database_id": "3a7f6bff-1451-4595-887a-95597dca45d2"
    }
  ]
}
